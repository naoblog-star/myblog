---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
	return tags.map((tag) => ({
		params: { tag },
		props: {
			posts: posts
				.filter((post) => post.data.tags.includes(tag))
				.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`${tag} の記事 | ${SITE_TITLE}`} description={`${tag} に関する記事一覧`} />
	</head>
	<body>
		<Header />
		<main>
			<div class="tag-header">
				<a href="/tags" class="back-link">← タグ一覧</a>
				<h1 class="page-title">
					<span class="tag-badge">{tag}</span>
					<span class="count">({posts.length}件)</span>
				</h1>
			</div>
			<ul class="post-list">
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`} class="post-card">
								<h2 class="post-title">{post.data.title}</h2>
								<p class="post-date">
									<FormattedDate date={post.data.pubDate} />
								</p>
								<p class="post-desc">{post.data.description}</p>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
<style>
	.tag-header { margin-bottom: 1.5em; }
	.back-link {
		display: inline-block;
		margin-bottom: 0.8em;
		font-size: 0.88em;
		color: rgb(var(--gray));
		text-decoration: none;
		padding: 0.3em 0.8em;
		background: white;
		border: 1.5px solid rgb(var(--gray-light));
		border-radius: 20px;
		transition: 0.2s;
	}
	.back-link:hover { border-color: var(--pink); color: var(--accent-dark); }
	.page-title {
		font-size: 1.3em;
		margin: 0.5em 0;
		padding-bottom: 0.6em;
		border-bottom: 2px dashed var(--pink);
		display: flex;
		align-items: center;
		gap: 0.6em;
	}
	.tag-badge {
		background: var(--pink-light);
		color: var(--accent-dark);
		padding: 0.2em 0.8em;
		border-radius: 20px;
		border: 1.5px solid var(--pink);
		font-size: 0.9em;
	}
	.count { font-size: 0.7em; color: rgb(var(--gray)); font-weight: normal; }
	.post-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1em; }
	.post-title { font-size: 1.05em; margin: 0 0 0.3em; color: rgb(var(--black)); }
	.post-date { font-size: 0.82em; color: rgb(var(--gray)); margin: 0 0 0.5em; }
	.post-desc { font-size: 0.88em; color: rgb(var(--gray-dark)); margin: 0; }
</style>
