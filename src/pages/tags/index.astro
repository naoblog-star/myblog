---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = await getCollection('blog');

const tagCount: Record<string, number> = {};
posts.forEach((post) => {
	post.data.tags.forEach((tag) => {
		tagCount[tag] = (tagCount[tag] || 0) + 1;
	});
});

const tags = Object.entries(tagCount).sort((a, b) => b[1] - a[1]);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`タグ一覧 | ${SITE_TITLE}`} description="タグ一覧" />
	</head>
	<body>
		<Header />
		<main>
			<h1 class="page-title">
				<span>🏷️</span> タグ一覧
			</h1>
			<div class="tag-cloud">
				{
					tags.map(([tag, count], i) => (
						<a href={`/tags/${tag}/`} class:list={['tag-item', `color-${(i % 3) + 1}`]}>
							{tag}
							<span class="count">{count}</span>
						</a>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>
<style>
	.page-title {
		font-size: 1.3em;
		margin-bottom: 1.5em;
		padding-bottom: 0.6em;
		border-bottom: 2px dashed var(--pink);
		display: flex;
		align-items: center;
		gap: 0.4em;
	}
	.tag-cloud {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8em;
	}
	.tag-item {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.45em 1.1em;
		border-radius: 24px;
		text-decoration: none;
		font-size: 0.92em;
		font-weight: 500;
		transition: 0.2s ease;
		border: 1.5px solid transparent;
	}
	.tag-item:hover {
		transform: translateY(-2px);
		box-shadow: 0 4px 12px rgba(196, 150, 200, 0.25);
	}
	.color-1 { background: var(--pink-light); color: var(--accent-dark); border-color: var(--pink); }
	.color-2 { background: var(--lavender-light); color: var(--lavender-deep); border-color: var(--lavender); }
	.color-3 { background: var(--mint-light); color: var(--mint-deep); border-color: var(--mint); }
	.count {
		background: rgba(0,0,0,0.07);
		border-radius: 10px;
		padding: 0.1em 0.5em;
		font-size: 0.78em;
	}
</style>
